{
  "name": "browser-vr-engine-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "npm run build && npm run test --workspace @browser-vr-engine/core",
    "check:plan": "node scripts/check-plan.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:ci-policy": "node scripts/check-ci-policy.mjs",
    "check:secret-exposure": "node scripts/check-secret-exposure.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "test:tooling": "node --test scripts/test/*.test.mjs",
    "test:consumer": "node scripts/test-consumer.mjs",
    "test:sharding": "node scripts/test-sharding.mjs",
    "ci:local": "node scripts/ci/run.mjs --local",
    "check": "npm run check:plan && npm run check:boundaries && npm run check:ci-policy && npm run check:secret-exposure && npm test && npm run test:tooling",
    "example:sdk": "npm run start --workspace @browser-vr-engine/sdk-smoke"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
